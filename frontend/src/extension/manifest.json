{
  "manifest_version": 3,
  "name": "GUI Text Extractor",
  "version": "1.0",
  "description": "Extracts GUI text and sends it to AI backend",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
